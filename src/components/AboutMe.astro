---
import { useT } from "@/i18n"

const t = useT(Astro.currentLocale)

const linkClass =
    "[&_a]:italic [&_a]:transition [&_a:hover]:underline [&_a:hover]:text-yellow-700 dark:[&_a:hover]:text-yellow-200"
---

<div class="relative overflow-hidden">
    <div
        class="pointer-events-none mx-auto mb-8 w-56 select-none overflow-hidden sm:w-64 md:absolute md:-right-12 md:top-1/2 md:mx-0 md:mb-0 md:w-[380px] md:-translate-y-1/2 lg:-right-20 lg:w-[480px]"
    >
        <div
            class="photo-blend absolute inset-[12%] rounded-full bg-yellow-500/10 blur-2xl dark:bg-yellow-400/[0.07]"
            aria-hidden="true"
        >
        </div>

        <img
            src="/mifoto_sinfondo.webp"
            alt={t.about.imageAlt}
            width="1176"
            height="941"
            loading="lazy"
            decoding="async"
            class="photo-blend relative w-full h-auto md:opacity-90 md:dark:opacity-80"
        />
    </div>

    <div
        class={`relative z-10 w-full md:max-w-[58%] lg:max-w-[560px] text-gray-700 dark:text-gray-300 text-pretty space-y-4 [&>p>strong]:text-yellow-700 dark:[&>p>strong]:text-yellow-200 [&>p>strong]:font-semibold text-base sm:text-lg leading-relaxed ${linkClass}`}
        data-reveal
    >
        {t.about.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
    </div>
</div>

<style>
    .photo-blend {
        -webkit-mask-image: radial-gradient(
            ellipse 80% 62% at 58% 38%,
            #000 36%,
            rgba(0, 0, 0, 0.55) 68%,
            transparent 93%
        );
        mask-image: radial-gradient(
            ellipse 80% 62% at 58% 38%,
            #000 36%,
            rgba(0, 0, 0, 0.55) 68%,
            transparent 93%
        );
    }

    /* el texto invade el lado izquierdo de la foto: ahi tiene que estar casi borrada */
    @media (min-width: 768px) {
        .photo-blend {
            -webkit-mask-image:
                radial-gradient(
                    ellipse 80% 62% at 58% 38%,
                    #000 36%,
                    rgba(0, 0, 0, 0.55) 68%,
                    transparent 93%
                ),
                linear-gradient(
                    to right,
                    transparent 8%,
                    #000 36%,
                    #000 54%,
                    transparent 78%
                );
            mask-image:
                radial-gradient(
                    ellipse 80% 62% at 58% 38%,
                    #000 36%,
                    rgba(0, 0, 0, 0.55) 68%,
                    transparent 93%
                ),
                linear-gradient(
                    to right,
                    transparent 8%,
                    #000 36%,
                    #000 54%,
                    transparent 78%
                );
            -webkit-mask-composite: source-in;
            mask-composite: intersect;
        }
    }
</style>
