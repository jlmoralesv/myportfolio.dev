---
import { useT } from "@/i18n"

const t = useT(Astro.currentLocale)

const linkClass =
    "[&_a]:italic [&_a]:transition [&_a:hover]:underline [&_a:hover]:text-yellow-500 dark:[&_a:hover]:text-yellow-200"
---

<article class="flex flex-col items-center justify-center gap-8 text-gray-700 dark:text-gray-300 md:flex-row">
    <div class={`[&>p]:mb-4 [&>p>strong]:text-yellow-400 [&>p>strong]:font-semibold text-pretty order-2 md:order-1 ${linkClass}`} data-reveal>
        {t.about.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
    </div>
    <img width="200" height="200" class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-black/20 dark:bg-yellow-500/5 ring-1 ring-black/70 dark:ring-white/20 transition-transform duration-500 hover:rotate-0 hover:scale-105" style="object-position: 50% 50%; --reveal-delay: 140ms" src="/me.webp" alt={t.about.imageAlt} data-reveal>
</article>
