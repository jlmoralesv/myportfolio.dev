---
import AngularIcon from "./icons/AngularIcon.astro"
import CloudflareIcon from "./icons/CloudflareIcon.astro"
import CppIcon from "./icons/CppIcon.astro"
import DockerIcon from "./icons/DockerIcon.astro"
import ExpressIcon from "./icons/ExpressIcon.astro"
import FlutterIcon from "./icons/FlutterIcon.astro"
import GoIcon from "./icons/GoIcon.astro"
import GraphQLIcon from "./icons/GraphQLIcon.astro"
import JavaScriptIcon from "./icons/JavaScriptIcon.astro"
import LookerIcon from "./icons/LookerIcon.astro"
import MySQLIcon from "./icons/MySQLIcon.astro"
import NextIcon from "./icons/NextIcon.astro"
import NodeIcon from "./icons/NodeIcon.astro"
import OllamaIcon from "./icons/OllamaIcon.astro"
import OpenAIIcon from "./icons/OpenAIIcon.astro"
import PhpIcon from "./icons/PhpIcon.astro"
import PostgreSQLIcon from "./icons/PostgreSQLIcon.astro"
import PowerBIIcon from "./icons/PowerBIIcon.astro"
import PythonIcon from "./icons/PythonIcon.astro"
import RedisIcon from "./icons/RedisIcon.astro"
import SupabaseIcon from "./icons/SupabaseIcon.astro"
import TailwindIcon from "./icons/TailwindIcon.astro"
import TypeScriptIcon from "./icons/TypeScriptIcon.astro"
import VueJSIcon from "./icons/VueJSIcon.astro"

const TECH = [
  TypeScriptIcon, JavaScriptIcon, NodeIcon, PythonIcon, GoIcon, PhpIcon,
  CppIcon, ExpressIcon, VueJSIcon, AngularIcon, NextIcon, TailwindIcon,
  PostgreSQLIcon, MySQLIcon, RedisIcon, SupabaseIcon, DockerIcon,
  CloudflareIcon, GraphQLIcon, FlutterIcon, OpenAIIcon, OllamaIcon,
  PowerBIIcon, LookerIcon,
]

const GOLDEN_ANGLE = 137.50776405

// distribucion de Fibonacci: reparte los puntos sin amontonarlos en los polos
const points = TECH.map((Icon, i) => {
  const y = 1 - (2 * i + 1) / TECH.length
  const lat = (Math.asin(y) * 180) / Math.PI
  return { Icon, lat: +lat.toFixed(2), lon: +((i * GOLDEN_ANGLE) % 360).toFixed(2) }
})
---

<div
  class="absolute inset-x-0 top-0 h-[22rem] hidden overflow-hidden pointer-events-none lg:block"
  aria-hidden="true"
>
  <div class="sphere-stage">
    <div class="sphere" data-sphere>
      {
        points.map(({ Icon, lat, lon }) => (
          <div
            class="sphere-item"
            data-lat={lat}
            data-lon={lon}
            style={`--lat:${lat}deg; --lon:${lon}deg`}
          >
            <span class="sphere-billboard">
              <Icon class="sphere-icon" />
            </span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .sphere-stage {
    position: absolute;
    top: 50%;
    right: 0;
    width: 19rem;
    height: 19rem;
    transform: translateY(-50%) scale(0.9);
    transform-origin: center right;
    perspective: 1000px;
    /* se desvanece hacia la izquierda, donde vive el texto del hero */
    mask-image: linear-gradient(to right, transparent, #000 62%);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 62%);
  }

  .sphere {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .sphere-item {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
    transform: rotateY(var(--lon)) rotateX(calc(-1 * var(--lat))) translateZ(8rem)
      rotateX(var(--lat)) rotateY(calc(-1 * var(--lon)));
  }

  .sphere-billboard {
    display: grid;
    place-items: center;
    /* sin JS las palabras igual quedan de frente, solo que quietas */
    opacity: 0.55;
  }

  .sphere-icon {
    width: 1.75rem;
    height: 1.75rem;
    color: rgba(15, 23, 42, 0.8);
  }

  :global(.dark) .sphere-icon {
    color: rgba(255, 255, 255, 0.85);
  }
</style>

<script>
  import gsap from "gsap"

  const sphere = document.querySelector<HTMLElement>("[data-sphere]")

  if (sphere && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const toRad = (deg: number) => (deg * Math.PI) / 180

    const items = Array.from(
      sphere.querySelectorAll<HTMLElement>(".sphere-item")
    ).map((item) => ({
      lat: toRad(Number(item.dataset.lat)),
      lon: toRad(Number(item.dataset.lon)),
      set: gsap.quickSetter(item.firstElementChild as Element, "css"),
    }))

    const spin = { y: 0 }

    gsap.to(spin, {
      y: 360,
      duration: 30,
      repeat: -1,
      ease: "none",
      onUpdate() {
        gsap.set(sphere, { rotationY: spin.y })

        // profundidad real del icono tras girar la esfera: z = cos(lat) * cos(lon + giro)
        const turn = toRad(spin.y)
        items.forEach(({ lat, lon, set }) => {
          const front = (Math.cos(lat) * Math.cos(lon + turn) + 1) / 2
          set({
            rotationY: -spin.y,
            opacity: 0.16 + front * 0.64,
            scale: 0.7 + front * 0.4,
          })
        })
      },
    })
  }
</script>
