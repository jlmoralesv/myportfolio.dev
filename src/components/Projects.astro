const CATEGORIES = (
	["featured", "web", "api", "app", "game", "data"] as const
).map((id) => ({ id, name: t.projects.categories[id] }));

const projects = PROJECTS.map((project) => ({
	...project,
	...t.projects.items[project.code as keyof typeof t.projects.items],
}));
---

<div class="flex flex-col gap-8">
	<nav class="flex justify-start" data-reveal>
		<ul
			class="flex flex-wrap gap-6"
		>
			{
				CATEGORIES.map(({ id, name }) => (
					<li>
						<button
							class={`category-btn px-4 py-0.5 text-sm rounded-md transition-all duration-300 bg-black/10 dark:bg-white/10 hover:bg-gray-200 dark:hover:bg-gray-700 hover:scale-105 ${id === "featured" ? "bg-gray-200 dark:bg-gray-700 font-medium" : ""}`}
							data-category={id}
							aria-pressed={id === "featured" ? "true" : "false"}
						>
							{name}
						</button>
					</li>
				))
			}
		</ul>
	</nav>

	<div class="flex flex-col gap-y-16">
		{
			projects.map(
				(
					{ code, type, image, title, description, tags, link, github, featured },
					index
				) => (
					<article
						class={`flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0 project-item transition-all duration-300 ${!featured ? "is-filtered" : ""}`}
						data-type={type}
						data-featured={featured ? "true" : "false"}
						data-reveal
						style={`--reveal-delay:${index * 90}ms`}
					>
						<div class="w-full md:w-1/2">
							<Carrusel images={image} carruselId={code} />
						</div>

						<div class="w-full md:w-1/2 md:max-w-lg">
							<div class="flex items-center gap-x-3">
								<h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
									{title}
								</h3>
								{featured && (
									<span class="inline-flex items-center gap-x-1 px-2.5 py-0.5 text-xs font-medium rounded-full bg-yellow-500/10 text-yellow-600 dark:text-yellow-300 border border-yellow-500/20">
										<svg class="size-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
										</svg>
										{t.projects.featuredBadge}
									</span>
								)}
							</div>
							<div class="flex flex-wrap mt-2">
								<ul class="flex flex-wrap mb-2 gap-x-2 gap-y-1">
									{tags.map((tag) => (
										<li>
											<span
												class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
											>
												<tag.icon class="size-4" />
												{tag.name}
											</span>
										</li>
									))}
								</ul>

								<div class="mt-2 text-gray-700 dark:text-gray-400">
									{description}
								</div>
								<footer class="flex items-end justify-start mt-4 gap-x-4">
									{github && (
										<LinkButton href={github} target="_blank">
											<GitHubIcon class="size-4" />
											{t.projects.code}
										</LinkButton>
									)}
									{link && (
										<LinkButton href={link} target="_blank">
											<LinkIcon class="size-4" />
											{t.projects.site}
										</LinkButton>
									)}
								</footer>
							</div>
						</div>
					</article>
				)
			)
		}

		<p id="no-projects-msg" class="hidden text-center text-gray-500 dark:text-gray-400 py-8">
			{t.projects.empty}
		</p>
	</div>
</div>

<style>
	.project-item.is-filtered {
		display: none;
	}

	.project-item.filter-in {
		animation: filter-in 0.45s ease-out;
	}

	@keyframes filter-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-item.filter-in {
			animation: none;
		}
	}
</style>

<script>
	const ACTIVE_CLASSES = ["bg-gray-200", "dark:bg-gray-700"]

	const categoryButtons =
		document.querySelectorAll<HTMLButtonElement>(".category-btn")
	const projects = document.querySelectorAll<HTMLElement>(".project-item")
	const noProjectsMsg = document.getElementById("no-projects-msg")

	document
		.querySelector('[data-category="featured"]')
		?.classList.add(...ACTIVE_CLASSES)

	categoryButtons.forEach((button) => {
		button.addEventListener("click", () => {
			categoryButtons.forEach((btn) => {
				btn.classList.remove(...ACTIVE_CLASSES)
				btn.setAttribute("aria-pressed", "false")
			})
			button.classList.add(...ACTIVE_CLASSES)
			button.setAttribute("aria-pressed", "true")

			const selected = button.dataset.category ?? "featured"

			let visibleCount = 0
			projects.forEach((project) => {
				const visible =
					selected === "featured"
						? project.dataset.featured === "true"
						: project.dataset.type === selected

				project.classList.toggle("is-filtered", !visible)
				project.classList.remove("filter-in")

				if (!visible) return
				visibleCount++
				// reinicia la animacion: sin leer el layout el navegador reusa el frame anterior
				void project.offsetWidth
				project.classList.add("filter-in")
			})

			if (noProjectsMsg) {
				noProjectsMsg.classList.toggle("hidden", visibleCount > 0)
			}
		})
	})
</script>
