const CATEGORIES = [
	{ id: "all", name: "Todos" },
	{ id: "web", name: "Web" },
	{ id: "api", name: "APIs" },
	{ id: "app", name: "Apps" },
	{ id: "game", name: "Juegos" },
	{ id: "data", name: "Data" },
