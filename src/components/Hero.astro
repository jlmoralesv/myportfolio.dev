---
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedInIcon.astro"
import MailIcon from "@/components/icons/MailIcon.astro"
import SocialPill from "@/components/SocialPill.astro"
import GitHubIcon from "./icons/GitHubIcon.astro"
import DowloadIcon from "./icons/DowloadIcon.astro"
import TechSphere from "./TechSphere.astro"
import { useT } from "@/i18n"

const t = useT(Astro.currentLocale)
const ROLES = t.hero.roles

---

<div class="relative">
  <TechSphere />

  <div class="relative max-w-xl">
    <div class="flex items-center gap-4 mb-4 fade-up" style="--d:0ms">
      <div
        class="grid shrink-0 size-14 place-items-center rounded-full border border-black/15 dark:border-white/15 bg-black/5 dark:bg-white/5"
      >
        <img
          class="w-auto h-5 logo-mark"
          src="/logo_portfolio.png"
          alt={t.hero.logoAlt}
          width="43"
          height="20"
        />
      </div>
      <a
        href="https://www.linkedin.com/in/jlmoralesv/"
        target="_blank"
        rel="noopener"
        class="flex items-center transition md:justify-center md:hover:scale-105"
      >
        <Badge>{t.hero.available}</Badge>
      </a>

      <span
        class="hidden sm:block px-2 py-0.5 text-[11px] uppercase tracking-wider rounded-md border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 text-gray-600 dark:text-gray-400"
      >
        {t.hero.location}
      </span>
    </div>

    <h1
      class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white fade-up"
      style="--d:80ms"
    >
      {t.hero.greeting}
    </h1>

    <p
      class="mt-4 text-xl font-semibold text-yellow-500 dark:text-yellow-200 fade-up"
      style="--d:140ms"
    >
      <span class="sr-only">{ROLES.join(", ")}</span>
      <span class="roles" data-roles={JSON.stringify(ROLES)} aria-hidden="true"
        >{ROLES[0]}</span
      ><span class="caret" aria-hidden="true"></span>
    </p>

    <p
      class="mt-4 text-lg text-gray-800 [&>strong]:text-gray-950 dark:[&>strong]:text-white [&>strong]:font-semibold dark:text-gray-300 text-pretty fade-up"
      style="--d:200ms"
    >
      <Fragment set:html={t.hero.bio} />
    </p>

    <nav class="flex flex-wrap gap-4 mt-8 fade-up" style="--d:260ms">
      <SocialPill href="https://www.linkedin.com/in/jlmoralesv/">
        <LinkedInIcon class="size-4 md:size-6" />
        LinkedIn
      </SocialPill>
      <SocialPill href="https://github.com/jlmoralesv">
        <GitHubIcon class="size-4 md:size-6" />
        GitHub
      </SocialPill>
      <SocialPill href="mailto:joseluismoralesvega24@gmail.com" target="_blank">
        <MailIcon class="size-4 md:size-6" />
        Gmail
      </SocialPill>
      <SocialPill href="https://cv.moraless.me/">
        <DowloadIcon class="size-4 md:size-6" />
        {t.hero.cv}
      </SocialPill>
    </nav>
  </div>

</div>

<style>
  .fade-up {
    animation: fade-up 0.9s ease-out var(--d, 0ms) both;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .roles {
    display: inline-block;
    height: 1.4em;
    line-height: 1.4em;
    vertical-align: bottom;
    white-space: nowrap;
  }

  .caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.05em;
    vertical-align: text-bottom;
    background: currentColor;
    animation: caret-blink 1.1s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-up,
    .caret {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const roles = document.querySelector<HTMLElement>("[data-roles]")
  const words: string[] = JSON.parse(roles?.dataset.roles ?? "[]")

  if (
    roles &&
    words.length > 1 &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    let index = 0
    let chars = words[0].length
    let deleting = true

    const tick = () => {
      const word = words[index]
      chars += deleting ? -1 : 1
      roles.textContent = word.slice(0, chars)

      let delay = deleting ? 45 : 90
      if (!deleting && chars === word.length) {
        deleting = true
        delay = 1900
      } else if (deleting && chars === 0) {
        deleting = false
        index = (index + 1) % words.length
        delay = 400
      }

      setTimeout(tick, delay)
    }

    setTimeout(tick, 1900)
  }
</script>
